# Shared settings for the rbac-tutorial admin scripts. Source it; do not run it.

# Storage
EOS_HOST=eospublic.cern.ch
EOS_PORT=8444
EOS_BASE=/eos/workspace/r/rucioit/rbac-tutorial
FTS=https://fts3-pilot.cern.ch:8446

# One RSE per entry: name:country:site:type (plain list, works with the macOS bash 3.2)
RSES="TRIESTE_DISK:IT:trieste:DISK
BOLOGNA_DISK:IT:bologna:DISK
GENEVA_DISK:CH:geneva:DISK
GENEVA_ARCHIVE:CH:geneva:ARCHIVE"
rse_names () { for spec in $RSES; do echo "${spec%%:*}"; done; }

# The rucio CLI logs "ERROR" but often exits with 0 (e.g. "rse show" of a missing RSE).
# This wrapper makes such calls fail, so that checks and "set -e" work.
rucio () {
  local errf rc
  errf="$(mktemp)"
  command rucio "$@" 2> "$errf"; rc=$?
  cat "$errf" >&2
  if [ "$rc" -eq 0 ] && grep -q "ERROR" "$errf"; then rc=1; fi
  rm -f "$errf"
  return "$rc"
}
export -f rucio   # also for "bash -c" in 06_check.sh

# DRY_RUN=1 ./<script>: read-only calls still run; each write call is only printed.
run () {
  if [ "${DRY_RUN:-0}" = 1 ]; then
    printf '[dry-run]'; printf ' %q' "$@"; echo
  else
    "$@"
  fi
}
if [ "${DRY_RUN:-0}" = 1 ]; then echo "=== DRY RUN: no changes are made ==="; fi
SOURCE_RSE=TRIESTE_DISK      # the admin pre-populates the data here
ARCHIVE_RSE=GENEVA_ARCHIVE   # second admin copy of the open data

# Scopes and roles
OPEN_SCOPE=mdmc-open
EMBARGO_SCOPE=mdmc-embargo
SCOPE_OWNER=root
STUDENT_ROLE=mdmc-student            # assignable: comes from IAM data-management/roles/mdmc-student
EMBARGO_ROLE=mdmc-embargo-reader     # not assignable: only an admin grants it, the IAM sync never touches it

# Quota per student on each RSE
STUDENT_QUOTA=2GB

# One Rucio account per line
STUDENTS_FILE="$(dirname "${BASH_SOURCE[0]}")/students.txt"
