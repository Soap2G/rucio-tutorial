# Shared settings for the rbac-tutorial admin scripts. Source it; do not run it.

# Storage. Two endpoints:
#  ws    = EOS workspace: the source RSE. The admin copies the data there with rsync (FUSE mount).
#  pilot = EOS pilot: the transfer destinations. The FTS robot (ESCAPE certificate) can write there.
EOS_HOST=eospublic.cern.ch                                             # ws
EOS_BASE="${EOS_BASE:-/eos/workspace/r/rucioit/rbac-tutorial}"         # ws; override only to test
PILOT_HOST=eospilot.cern.ch
PILOT_BASE=/eos/pilot/eulake/rbac-tutorial
EOS_PORT=8444
FTS=https://fts3-pilot.cern.ch:8446

# One RSE per entry: name:country:site:type:endpoint (plain list, works with the macOS bash 3.2)
RSES="TRIESTE_DISK:IT:trieste:DISK:ws
BOLOGNA_DISK:IT:bologna:DISK:pilot
GENEVA_DISK:CH:geneva:DISK:pilot
GENEVA_ARCHIVE:CH:geneva:ARCHIVE:pilot"
rse_names () { for spec in $RSES; do echo "${spec%%:*}"; done; }
# endpoint (ws|pilot) -> "host base"
endpoint () { case "$1" in ws) echo "$EOS_HOST $EOS_BASE";; pilot) echo "$PILOT_HOST $PILOT_BASE";; *) echo "unknown endpoint $1" >&2; return 1;; esac; }

# grep -q stops reading early; with "set -o pipefail" the writer then fails on the closed pipe
# and the check gives a wrong answer. This reads all input.
has () { grep "$@" > /dev/null; }
export -f has

# The rucio CLI logs "ERROR" but often exits with 0 (e.g. "rse show" of a missing RSE).
# This wrapper makes such calls fail, so that checks and "set -e" work.
# stderr is shown live (tee) and also kept to look for ERROR.
rucio () {
  local errf rc
  errf="$(mktemp)"
  { command rucio "$@" 2>&1 1>&3 3>&- | tee "$errf" >&2; rc=${PIPESTATUS[0]}; } 3>&1
  if [ "$rc" -eq 0 ] && has "ERROR" "$errf"; then rc=1; fi
  rm -f "$errf"
  return "$rc"
}
export -f rucio   # also for "bash -c" in 06_check.sh

# Log in once, before any other call, and show which account the scripts use.
# Without a valid token, the client asks for the OIDC login here, not in the middle of a step.
if [ -z "${TUTORIAL_LOGGED_IN:-}" ]; then
  echo "=== Rucio config: ${RUCIO_CONFIG:-default}"
  command rucio whoami   # not filtered: the OIDC login link (if any) must stay visible
  command rucio whoami 2>&1 | grep "^account" > /dev/null || { echo "ERROR: not logged in to Rucio" >&2; exit 1; }
  # Write steps need root or the "admin" account attribute. Without it, the RSE endpoints answer
  # AccessDenied as HTTP 401, and the client asks for a new OIDC login again and again.
  TUTORIAL_ACCOUNT="$(command rucio whoami 2>/dev/null | awk '$1 == "account" {print $3}')"
  if [ "${DRY_RUN:-0}" != 1 ] && [ "$TUTORIAL_ACCOUNT" != root ] \
     && ! command rucio account attribute list "$TUTORIAL_ACCOUNT" 2>/dev/null | has -E "^\|? *admin +\|? *True"; then
    echo "ERROR: account '$TUTORIAL_ACCOUNT' is not root and has no 'admin' attribute." >&2
    echo "       Use a root configuration, or ask root to run:" >&2
    echo "       rucio account attribute set $TUTORIAL_ACCOUNT --key admin --value True" >&2
    exit 1
  fi
  export TUTORIAL_LOGGED_IN=1 TUTORIAL_ACCOUNT
fi

# Command names differ between client versions: up to 40.x "add" (rse attribute, rse distance,
# account limit, did metadata) and "--host-name"; the 41.x RBAC fork uses "set" and "--hostname".
if command rucio rse attribute --help 2>/dev/null | has -E "^  set "; then SET=set; else SET=add; fi
if command rucio rse protocol add --help 2>/dev/null | has -- "--hostname"; then HOSTNAME_OPT=--hostname; else HOSTNAME_OPT=--host-name; fi

# DRY_RUN=1 ./<script>: read-only calls still run; each write call is only printed.
run () {
  if [ "${DRY_RUN:-0}" = 1 ]; then
    printf '[dry-run]'; printf ' %q' "$@"; echo
  else
    "$@"
  fi
}
if [ "${DRY_RUN:-0}" = 1 ]; then echo "=== DRY RUN: no changes are made ==="; fi
SOURCE_RSE=TRIESTE_DISK      # the admin pre-populates the data here
ARCHIVE_RSE=GENEVA_ARCHIVE   # second admin copy of the open data

# Scopes and roles
OPEN_SCOPE=mdmc-open
EMBARGO_SCOPE=mdmc-embargo
SCOPE_OWNER=root
STUDENT_ROLE=mdmc-student            # assignable: comes from IAM data-management/roles/mdmc-student
EMBARGO_ROLE=mdmc-embargo-reader     # not assignable: only an admin grants it, the IAM sync never touches it

# Quota per student on each RSE
STUDENT_QUOTA=2GB

# One Rucio account per line
STUDENTS_FILE="$(dirname "${BASH_SOURCE[0]}")/students.txt"
