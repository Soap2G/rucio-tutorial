# Settings for the CTAO demonstrator (Rucio Workshop). Source it; do not run it.
# Uses the RSEs, helpers and checks of tutorial.env.
source "$(dirname "${BASH_SOURCE[0]}")/tutorial.env"

# One scope per proposal. The data management team (DMT) owns them: here root / admin accounts.
CTAO_PROPOSAL_SCOPES="ctao-prop-a ctao-prop-b ctao-prop-c"
CTAO_PUBLIC_AT_START="ctao-prop-c"        # proprietary period already over
CTAO_CATALOGUE_SCOPE=ctao-catalogue        # search results that mix proposals (case 4)
CTAO_SEARCH_DATASET="$CTAO_CATALOGUE_SCOPE:search-2026-10"

# Roles. Assignable roles come from IAM groups data-management/roles/<role>.
# The PI and co-PI are the IAM group managers of their proposal group.
CTAO_PUBLIC_ROLE=ctao-public               # every scientist with an account; NOT locked: its permissions grow when an embargo ends
proposal_role () { echo "$1"; }            # proposal scope ctao-prop-x -> role ctao-prop-x
